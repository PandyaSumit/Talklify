// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  HOST
  ATTENDEE
  BOTH
}

enum SubscriptionTier {
  FREE
  PRO
  BUSINESS
}

model User {
  id                      String           @id @default(cuid())
  email                   String           @unique
  emailVerified           DateTime?
  password                String?
  name                    String
  userType                UserType         @default(ATTENDEE)
  subscriptionTier        SubscriptionTier @default(FREE)
  profileImage            String?
  bio                     String?
  timezone                String           @default("UTC")
  stripeCustomerId        String?          @unique
  stripeConnectAccountId  String?          @unique
  isVerified              Boolean          @default(false)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  // Relations
  hostedSessions          Session[]        @relation("HostedSessions")
  bookings                Booking[]
  reviews                 Review[]
  payments                Payment[]        @relation("HostPayments")
  follows                 Follow[]         @relation("UserFollows")
  followers               Follow[]         @relation("UserFollowers")
  topicSubscriptions      TopicSubscription[]
  notifications           Notification[]
  accounts                Account[]
  sessions                NextAuthSession[]

  @@index([email])
  @@map("users")
}

// NextAuth Account model
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth Session model
model NextAuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("nextauth_sessions")
}

// NextAuth VerificationToken model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum SessionStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MeetingPlatform {
  ZOOM
  GOOGLE_MEET
  MICROSOFT_TEAMS
}

model Session {
  id                String          @id @default(cuid())
  hostId            String
  host              User            @relation("HostedSessions", fields: [hostId], references: [id], onDelete: Cascade)
  title             String
  slug              String          @unique
  description       String
  sessionDate       DateTime
  duration          Int             // in minutes
  meetingPlatform   MeetingPlatform
  meetingLink       String
  category          String
  tags              String[]
  difficultyLevel   DifficultyLevel
  price             Float           @default(0)
  currency          String          @default("USD")
  maxAttendees      Int
  currentAttendees  Int             @default(0)
  status            SessionStatus   @default(DRAFT)
  coverImage        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  bookings          Booking[]
  reviews           Review[]
  analytics         SessionAnalytics[]

  @@index([hostId])
  @@index([sessionDate])
  @@index([category])
  @@index([status])
  @@index([slug])
  @@map("sessions")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

model Booking {
  id                    String        @id @default(cuid())
  userId                String
  sessionId             String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session               Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  paymentStatus         PaymentStatus @default(PENDING)
  paymentAmount         Float
  stripePaymentIntentId String?       @unique
  attended              Boolean       @default(false)
  reminderSent24h       Boolean       @default(false)
  reminderSent1h        Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Relations
  payment               Payment?

  @@unique([userId, sessionId])
  @@index([userId])
  @@index([sessionId])
  @@index([paymentStatus])
  @@map("bookings")
}

model Review {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sessionId])
  @@index([sessionId])
  @@index([userId])
  @@map("reviews")
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String        @unique
  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hostId                String
  host                  User          @relation("HostPayments", fields: [hostId], references: [id], onDelete: Cascade)
  amount                Float
  platformFee           Float
  hostAmount            Float
  currency              String        @default("USD")
  stripePaymentIntentId String        @unique
  status                PaymentStatus
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([hostId])
  @@index([status])
  @@map("payments")
}

model Payout {
  id                   String        @id @default(cuid())
  hostId               String
  amount               Float
  currency             String        @default("USD")
  stripeTransferId     String        @unique
  status               PaymentStatus
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([hostId])
  @@map("payouts")
}

model SessionAnalytics {
  id             String   @id @default(cuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  views          Int      @default(0)
  clicks         Int      @default(0)
  registrations  Int      @default(0)
  conversionRate Float    @default(0)
  revenue        Float    @default(0)
  date           DateTime @default(now())

  @@unique([sessionId, date])
  @@index([sessionId])
  @@map("session_analytics")
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followeeId String
  follower   User     @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("UserFollowers", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, followeeId])
  @@index([followerId])
  @@index([followeeId])
  @@map("follows")
}

model TopicSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     String
  createdAt DateTime @default(now())

  @@unique([userId, topic])
  @@index([userId])
  @@map("topic_subscriptions")
}

enum NotificationType {
  SESSION_REMINDER
  NEW_BOOKING
  SESSION_CANCELLED
  REVIEW_RECEIVED
  NEW_FOLLOWER
  NEW_SESSION_FROM_HOST
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([read])
  @@map("notifications")
}
